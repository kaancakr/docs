{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "ApyGuard Docs",
  "description": "Documentation for onboarding, core workflows, and authentication in ApyGuard.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Documentation",
          "icon": "book-open",
          "href": "/get-started/introduction"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Documentation",
        "icon": "book-open",
        "expanded": true,
        "pages": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "get-started/introduction",
              "get-started/quick-start",
              "get-started/create-your-first-asset",
              "get-started/import-collection",
              "get-started/security-scanning"
            ]
          },
          {
            "group": "Core Workflows",
            "icon": "shield",
            "pages": [
              "core-workflows/assets",
              "core-workflows/api-collections",
              "core-workflows/authorization-settings",
              "core-workflows/credentials",
              "core-workflows/scheduled-scan-tasks"
            ]
          },
          {
            "group": "Authentication",
            "icon": "key-round",
            "pages": [
              "authentication/overview",
              "authentication/predefined-token",
              "authentication/login-url",
              "authentication/oidc",
              "authentication/oauth2-password",
              "authentication/oauth2-client-credentials",
              "authentication/authorization-matrix",
              "authentication/authentication-issues"
            ]
          },
          {
            "group": "Findings & Results",
            "icon": "bug",
            "pages": [
              "findings-results/overview",
              "findings-results/understanding-results",
              "findings-results/vulnerabilities",
              "findings-results/sensitive-data-findings",
              "findings-results/risk-scores",
              "findings-results/compliance-reporting"
            ]
          },
          {
            "group": "Monitoring & Posture",
            "icon": "chart-line",
            "pages": [
              "monitoring-and-posture/api-security-posture",
              "monitoring-and-posture/posture-tracking",
              "monitoring-and-posture/scan-history",
              "monitoring-and-posture/alerts-and-notifications"
            ]
          },
          {
            "group": "Integrations",
            "icon": "plug",
            "pages": [
              "integrations/overview",
              "integrations/github-actions",
              "integrations/jira",
              "integrations/postman",
              "integrations/slack"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/apyguard.png",
    "dark": "/logo/apyguard.png"
  },
  "navbar": {
    "links": []
  },
  "footer": {}
}
